{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "resolveJsonModule": true
  },
  "include": ["src/*.ts"],
  "exclude": ["src/*.test.ts", "node_modules", "dist"]
}
