    "boardgame.io": "0.49.13",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.13",
    "@types/node": "^22.9.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  }
}
